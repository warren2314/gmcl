# Database (required)
DB_DSN=postgres://appuser:apppassword@localhost:5432/appdb?sslmode=disable

# App
APP_HTTP_ADDR=:8080
APP_ENV=dev
PUBLIC_BASE_URL=https://gmcl.co.uk
PUBLIC_ALT_BASE_URL=https://www.gmcl.co.uk
SANCTIONS_BASE_URL=https://sanctions.gmcl.co.uk
SANCTIONS_EVIDENCE_DIR=/app/data/sanction-evidence
SANCTIONS_IMPORT_DIR=/app/data/sanction-imports
# Hard kill switch for every sanctions email path. Set to true on staging.
SANCTIONS_EMAIL_DISABLED=false

# Run migrations and seed on startup (set for local Docker)
MIGRATE=1
MIGRATE_DIR=/migrations
SEED=1
SEED_ADMIN_PASSWORD=admin123

# Captain session signing (required for captain flow)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: SMTP for 2FA and magic link emails (leave unset in dev to log to stdout)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Optional mailbox that receives replies to general transactional messages.
# SMTP_REPLY_TO=joep@gtrmcrcricket.co.uk
# Starred-player messages always use this mailbox (shown value is the default).
# STARRED_PLAYER_REPLY_TO=joep@gtrmcrcricket.co.uk
# Captain-report messages use this dedicated mailbox (shown value is the default).
# CAPTAIN_REPORT_REPLY_TO=reports@gtrmcrcricket.co.uk
# Optional: SES configuration set name for delivery/bounce/complaint events.
# SES_CONFIGURATION_SET=gmcl-captain-reports

# Optional: Amazon SES SNS bounce/complaint webhook.
# Configure the SNS HTTPS endpoint as:
# https://your-domain.example/webhooks/aws/ses?token=<same-token>
# SES_SNS_WEBHOOK_TOKEN=change-me
# SES_SNS_WEBHOOK_TOKEN_NEXT=temporary-token-used-only-during-rotation
# SES_SNS_TOPIC_ARN=arn:aws:sns:eu-west-2:123456789012:gmcl-ses-events
# SES_SNS_AUTO_CONFIRM=0
# Leave raw delivery disabled so wrapped SNS messages are signature-verified.
# SES_SNS_ALLOW_RAW=0

# Optional: HMAC secret for /internal/* endpoints (n8n)
# N8N_HMAC_SECRET=your-shared-secret

# Private ineligible-player Google Form intake. This switch is independent of
# SANCTIONS_EMAIL_DISABLED: syncing never sends club correspondence or creates
# a sanctions case. Share the response sheet and its Form upload folder read-only
# with the service account.
INELIGIBLE_IMPORT_ENABLED=false
# One-time bootstrap: permits authenticated admin Sync now before the tracker
# application exists. It never permits n8n to bypass the rollout gate. Disable
# immediately after the initial response sheet has been staged.
INELIGIBLE_BOOTSTRAP_IMPORT_ENABLED=false
# Before native activation, the ineligible-player website link redirects to
# this private Google Form (use the form URL, not its response spreadsheet).
# INELIGIBLE_PRIVATE_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/.../viewform
# Independent outbound release switch. Keep false through backfill and
# reconciliation; queued ineligible messages remain unsent until enabled.
INELIGIBLE_OUTBOUND_EMAIL_ENABLED=false
# INELIGIBLE_GOOGLE_SPREADSHEET_ID=18I8JoouigCOX-sja3lfHguSZtOF3EwJIFIZ2Cee2uR8
# INELIGIBLE_GOOGLE_SHEET_GID=1964965743
# Defaults to the reviewed protected-form range shown below.
# INELIGIBLE_GOOGLE_SHEET_RANGE='Form responses 1'!A:N
# Prefer a read-only mounted secret file in production. Set exactly one of
# GOOGLE_SERVICE_ACCOUNT_FILE or GOOGLE_SERVICE_ACCOUNT_JSON.
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/gmcl-google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"...","token_uri":"https://oauth2.googleapis.com/token"}
# INELIGIBLE_GOOGLE_HTTP_TIMEOUT_SEC=45
# Immutable, content-addressed copies of permitted File Upload links. The
# default path is already covered by the app's /app/data persistent volume.
# INELIGIBLE_UPLOAD_DIR=/app/data/ineligible-uploads
# INELIGIBLE_BACKFILL_DIR=/app/data/ineligible-backfills
# INELIGIBLE_UPLOAD_MAX_FILES=5
# INELIGIBLE_UPLOAD_MAX_FILE_BYTES=10485760
# INELIGIBLE_UPLOAD_MAX_TOTAL_BYTES=26214400
# INELIGIBLE_UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
# Optional atomic override for a deliberately revised form. It must contain
# exactly 14 literal headers plus zero-based timestamp/reporter_email/reporting_club/
# offending_club/team/player/fixture_date/file_upload column indexes.
# INELIGIBLE_GOOGLE_SCHEMA_JSON={"headers":["Timestamp","Email address","Name of defaulting player as shown on scorecard","Reason you believe the player is ineligible","Additional Info","Your Club","Your Name & Role at Club/League","Your Preferred tel no","Offending Club's Name","Team in question","Fixture Date","Additional Evidence","File Upload","Score"],"columns":{"timestamp":0,"reporter_email":1,"player":2,"reporting_club":5,"offending_club":8,"team":9,"fixture_date":10,"file_upload":12}}

# Optional: OpenAI-backed narrative generation for AI Executive reports.
# If OPENAI_API_KEY is unset, reports still generate with deterministic narrative text.
# OPENAI_API_KEY=
# OPENAI_REPORT_MODEL=gpt-5.2
# OPENAI_CHAT_MODEL=gpt-5.6-terra
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RULES_SOURCE_URL=https://www.gtrmcrcricket.co.uk/pages/rules-main-menu
# RULES_ASSISTANT_SECRET=replace-with-a-long-random-value
RULES_ASSISTANT_ENABLED=false

# League / Play-Cricket API (optional — for syncing fixtures and umpire prefill)
# PLAY_CRICKET_API_BASE_URL=https://your-league-api-host
# PLAY_CRICKET_API_KEY=
# PLAY_CRICKET_LEAGUE_ID=11685
# Path appended to base URL; {leagueId} and {date} are substituted (date default dd/MM/yyyy)
# PLAY_CRICKET_MATCHES_URL_TEMPLATE=/?league_id={leagueId}&match_date={date}
# PLAY_CRICKET_MATCH_DETAIL_URL_TEMPLATE=/api/v2/match_detail.json?match_id={matchId}
# PLAY_CRICKET_DATE_FORMAT=dd/MM/yyyy
# PLAY_CRICKET_AUTH_QUERY_PARAM=api_token
# PLAY_CRICKET_AUTH_HEADER=
# PLAY_CRICKET_HTTP_TIMEOUT_SEC=30

# Public published Google Sheet used for the 2026 starred-player list.
# STARRED_PLAYERS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vS_jUUxFnK1V0zjnrHfIjp-MAEftFsjXrzjSj0hKBywU8T_r9KBQ8mmdo_agQp1BF5XEZC59-jIoILa/pub?gid=1336530032&single=true&output=csv
# Active admin username assigned to every new ineligible-player investigation.
# INELIGIBLE_DEFAULT_ASSIGNEE_USERNAME=hussan
