# The release script supplies a locally cross-compiled demo executable.
# Reuse the verified production runtime; no source, .env or backups enter it.
FROM gmcl-app
COPY junior-demo /bin/junior-demo
COPY migrations /migrations
COPY static /static
COPY images /images
RUN addgroup -S junior-demo && adduser -S -G junior-demo junior-demo \
    && mkdir -p /demo-data && chown junior-demo:junior-demo /demo-data
USER junior-demo
ENV DEMO_HTTP_ADDR=:8080 DEMO_MIGRATE_DIR=/migrations DEMO_ASSET_DIR=/
EXPOSE 8080
ENTRYPOINT ["/bin/junior-demo"]
